# scout.world
# 第二个机器人项目 (Task 2) —— Stage 场景文件
#
# 这个文件定义整个仿真场景:
#   - 引用 scout.inc 里的机器人模型
#   - 加载 Task 1 用 slam_toolbox 建好的地图 (map.png)
#   - 放置 Scout Mini 机器人
#
# 注意:bitmap 路径写【相对路径】,不要写绝对路径(否则 0 分)。
#       launch 文件运行时的工作目录应在 world/ 或 map/ 文件夹,
#       或把 map.png 也复制到 world/ 文件夹里。

# 引入机器人模型定义
include "scout.inc"

# -------------------- 全局仿真参数 --------------------
# bitmap 分辨率:每像素对应多少米。
# 必须和你 Task 1 建图时 map.yaml 里的 resolution 一致!(通常 0.05)
resolution 0.05

# 仿真步长,单位毫秒。100ms = 10Hz
interval_sim 100

# -------------------- GUI 窗口 --------------------
window
(
  size [ 800.0 600.0 ]    # 窗口像素大小
  center [ 0.0 0.0 ]      # 视图中心
  rotate [ 0.0 0.0 ]
  scale 20                # 缩放,数字越大看得越近
)

# -------------------- 地图(障碍物边界)--------------------
# floorplan 是静态障碍物,激光会打到它
define floorplan model
(
  color "gray30"
  boundary 0          # 不自动加外边界,用图片本身的墙
  gui_nose 0
  gui_grid 0
  gui_outline 0
  gripper_return 0
  fiducial_return 0
  ranger_return 1     # 激光能检测到它
)

floorplan
(
  name "map"
  # *** 用你 Task 1 生成的地图图片 ***
  bitmap "../map/my_map.png"
  # size [宽 高 厚度],单位米。
  # 必须 = 地图像素尺寸 × resolution。
  # 例:地图 png 是 400×300 像素,resolution 0.05,
  #     则 size = [20.0 15.0 2.0]
  # 这个值你建完图后要按实际改!
  size [ 30.85 17.75 2.0 ]
  # pose [x y z theta]:地图原点位置。
  # 要和 map.yaml 里的 origin 对应,通常需要微调让坐标系对齐
  pose [ 8.545 -4.125 0.0 0.0 ]
)

# -------------------- 放置机器人 --------------------
scout_mini
(
  # 机器人初始位姿,要放在地图内的空旷处。
  # 建议设成 goals.csv 第一个目标附近的可达点,或地图中心空地。
  pose [ 0.0 0.0 0.0 0.0 ]
  name "scout"
  color "blue"
)
