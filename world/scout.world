# scout.world
# Second robotics project - Stage world file
#
# This file defines the full simulation scene:
#   - Include the robot model from scout.inc.
#   - Load the map generated in Task 1 with slam_toolbox (map.png).
#   - Place the Scout Mini robot in the world.
#
# Note: keep the bitmap path relative. Do not use an absolute path.
# The launch file should run from the world/ or map/ directory, or map.png
# should also be copied into the world/ directory.

# Include the robot model definition.
include "scout.inc"

# -------------------- Global simulation parameters --------------------
# Bitmap resolution: meters per pixel.
# Must match the resolution in the Task 1 map.yaml file, usually 0.05.
resolution 0.05

# Simulation interval in milliseconds. 100 ms = 10 Hz.
interval_sim 100

# -------------------- GUI window --------------------
window
(
  size [ 1400.0 850.0 ]   # Window size in pixels.
  center [ 8.545 -4.125 ] # View center aligned with the map center.
  rotate [ 0.0 0.0 ]
  scale 45                # Zoom level; larger values show a closer view.
)

# -------------------- Map and obstacle boundaries --------------------
# The floorplan is a static obstacle layer detected by the laser.
define floorplan model
(
  color "gray30"
  boundary 0          # Do not add an automatic outer boundary; use the image walls.
  gui_nose 0
  gui_grid 0
  gui_outline 0
  gripper_return 0
  fiducial_return 0
  ranger_return 1     # Make it visible to the laser.
)

floorplan
(
  name "map"
  # Use the map image generated in Task 1.
  bitmap "../map/my_map.png"
  # size [width height thickness], in meters.
  # Must equal map image pixel size multiplied by the resolution.
  # Example: for a 400 x 300 pixel map with resolution 0.05,
  # size should be [20.0 15.0 2.0].
  # Adjust this value after generating the final map.
  size [ 30.85 17.75 2.0 ]
  # pose [x y z theta]: map origin position.
  # This should match the origin in map.yaml, with small tuning if needed.
  pose [ 8.545 -4.125 0.0 0.0 ]
)

# -------------------- Place the robot --------------------
scout_mini
(
  # Initial robot pose. Place it in a free area inside the map.
  # A reachable point near the first goals.csv entry or the map center is a good choice.
  pose [ 0.0 0.0 0.0 0.0 ]
  name "scout"
  color "blue"
)
